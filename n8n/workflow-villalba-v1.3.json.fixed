      "parameters": {
        "jsCode": "// ═══════════════════════════════════════════════════════\n// GUARD — Rate Limiting + Payload Validation\n// SOLO procesa user_message. TODO lo demás se ignora.\n// ═══════════════════════════════════════════════════════\nconst item = $input.first();\nconst binary = item.binary;\nconst body = item.json.body || {};\nconst headers = item.json.headers || {};\nconst errors = [];\n\nconst clientId = body.clientId || body.client_id || '';\nconst visitorId = body.visitorId || body.visitor_id || '';\nconst action = body.action || '';\nconst text = body.text || '';\n\n// ══════════════════════════════════════════════════\n// FILTRO ESTRICTO: Solo user_message pasa.\n// user_abandoned_page, file_upload, get_availability\n// y cualquier otra accion se IGNORAN silenciosamente.\n// Esto evita que el abandono de pagina sobreescriba\n// datos del lead recien captados (race condition).\n// ══════════════════════════════════════════════════\nif (action !== 'user_message') {\n  return [{ json: { body, headers, _guard: { passed: false, statusCode: 200, errors: ['Ignored: ' + (action || 'no-action')], silent: true } } }];\n}\n\nif (!clientId) errors.push('Missing clientId');\nif (!visitorId) errors.push('Missing visitorId');\nif (!text || text.trim().length === 0) errors.push('Empty message');\nif (text && text.length > 2000) errors.push('Text exceeds limit');\n\n// Rate limiting\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.rateLimits) staticData.rateLimits = {};\nconst now = Date.now();\nconst WINDOW_MS = 60000;\nconst MAX_PER_VISITOR = 10;\n\nif (visitorId) {\n  const vKey = 'v_' + visitorId;\n  if (!staticData.rateLimits[vKey]) staticData.rateLimits[vKey] = [];\n  staticData.rateLimits[vKey] = staticData.rateLimits[vKey].filter(ts => now - ts < WINDOW_MS);\n  if (staticData.rateLimits[vKey].length >= MAX_PER_VISITOR) {\n    errors.push('Rate limit exceeded');\n  } else {\n    staticData.rateLimits[vKey].push(now);\n  }\n}\n\n// Cleanup old entries every 100 requests\nif (!staticData._cleanupCounter) staticData._cleanupCounter = 0;\nstaticData._cleanupCounter++;\nif (staticData._cleanupCounter >= 100) {\n  staticData._cleanupCounter = 0;\n  for (const key of Object.keys(staticData.rateLimits)) {\n    staticData.rateLimits[key] = staticData.rateLimits[key].filter(ts => now - ts < WINDOW_MS);\n    if (staticData.rateLimits[key].length === 0) delete staticData.rateLimits[key];\n  }\n}\n\nconst passed = errors.length === 0;\nconst result = { json: { body, headers, _guard: { passed, statusCode: passed ? 200 : 400, errors } } };\nif (binary && Object.keys(binary).length > 0) result.binary = binary;\nreturn [result];"
      },
